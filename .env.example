# ---- Database ----
DATABASE_URL=postgres://postgres@localhost:5433/hrms
# The application connects as a NON-OWNER role that cannot bypass RLS.
APP_DATABASE_URL=postgres://hrms_app:change-me@localhost:5433/hrms

# ---- Telemetry kill list (docs/06-technology-decisions.md) ----
# These belong in the Dockerfile and CI, not only on a laptop.
NEXT_TELEMETRY_DISABLED=1
K6_NO_USAGE_REPORT=1
DO_NOT_TRACK=1

# ---- AI gateway ----
# Off by default. A tenant opts in explicitly (PRIV-06, COMP-79).
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_REGION=

# apps/web — session cookie sealing key (AES-256-GCM). 32 bytes, base64.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The application refuses to start without it rather than inventing one: a
# process that generates its own key seals sessions no other instance can read,
# which shows up as random sign-outs behind a load balancer and gets diagnosed
# as a bug in something else entirely.
SESSION_COOKIE_KEY=
