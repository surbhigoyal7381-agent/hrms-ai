# ---- Database ----
DATABASE_URL=postgres://postgres@localhost:5433/hrms
# The application connects as a NON-OWNER role that cannot bypass RLS.
APP_DATABASE_URL=postgres://hrms_app:change-me@localhost:5433/hrms

# ---- Telemetry kill list (docs/06-technology-decisions.md) ----
# These belong in the Dockerfile and CI, not only on a laptop.
NEXT_TELEMETRY_DISABLED=1
K6_NO_USAGE_REPORT=1
DO_NOT_TRACK=1

# ---- AI gateway ----
# Off by default. A tenant opts in explicitly (PRIV-06, COMP-79).
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_REGION=

# apps/web — session cookie sealing key (AES-256-GCM). 32 bytes, base64.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The application refuses to start without it rather than inventing one: a
# process that generates its own key seals sessions no other instance can read,
# which shows up as random sign-outs behind a load balancer and gets diagnosed
# as a bug in something else entirely.
SESSION_COOKIE_KEY=

# ---- Sign-in (OIDC / Keycloak) — apps/web, feature 002 slice 3c ----
# NOT VERIFIED against a real Keycloak. The flow logic is tested against a
# synthetic issuer; these values are the wiring that has not been exercised.
#
# No defaults for any of the first four. A default issuer would mean a
# misconfigured deployment silently authenticating against the wrong identity
# provider, which is indistinguishable from working until somebody signs in with
# an account we do not control.
OIDC_ISSUER=https://keycloak.example/realms/thrive
OIDC_CLIENT_ID=thrive-web
OIDC_CLIENT_SECRET=
# Must match a redirect URI registered on the Keycloak client, exactly.
OIDC_REDIRECT_URI=https://northwind.thrive.app/signin/callback
# How long a started sign-in stays valid before the callback is too late.
# 1..3600 seconds. A pending sign-in that never expires is a `state` value an
# attacker can take their time with.
OIDC_AUTHORIZATION_TTL_SECONDS=600
